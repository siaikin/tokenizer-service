# 必填：Bearer 鉴权 Token
TOKENIZER_TOKEN=your-secret-token-here

# 可选：监听地址（默认 0.0.0.0:8080）
TOKENIZER_BIND=0.0.0.0:8080

# 可选：SQLite 路径（默认 /data/tokenizer.db；本地可用 ./data/tokenizer.db）
TOKENIZER_DB_PATH=./data/tokenizer.db

# 可选：最大并发（默认 = CPU 核数）
# TOKENIZER_MAX_CONCURRENCY=4

# 可选：请求体上限 MB（默认 8）
# TOKENIZER_MAX_BODY_MB=8
